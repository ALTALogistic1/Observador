# Copier vers .env et remplir. Jamais commité (voir .gitignore).

# Base de données du PRODUIT (par défaut : SQLite local, suffisant pour la Phase 1 /
# usage solo). En production : la base distante `libsql://…`, qui porte les ~3 000
# lignes qui ne se reconstruisent pas.
FALKYE_DB_URL=sqlite:///./data/falkye.sqlite3

# Base des MIROIRS — miroirs de sources et état de diff, 5,7 M de lignes, ~2 Go.
# TOUJOURS un fichier local, jamais la base distante : l'import du miroir REQ prend
# 33 minutes sur disque contre ~168 heures au distant (2 allers-retours par ligne à
# 111 ms, mesuré le 2026-09-06). Indépendante de FALKYE_DB_URL à dessein — faire
# dériver l'une de l'autre rendrait le découpage implicite. Se rebâtit entièrement :
# voir docs/MIROIRS.md.
FALKYE_MIROIR_DB_URL=sqlite:///./data/miroirs.sqlite3

# Point d'entrée HTTPS public — origine des liens de désabonnement (RFC 8058) et
# de rétroaction placés dans les courriels. Ex. https://lien.falkye.com
# Sous-domaine SÉPARÉ de avis.falkye.com, qui porte les envois : un incident sur
# l'un ne touche pas l'autre. SANS cette variable, aucun résumé ne part — un
# en-tête de désabonnement inutilisable serait décoratif, ce que le mandat interdit.
FALKYE_LIEN_BASE_URL=

# Canal d'envoi RÉEL — Postmark, API HTTPS (falkye/notifications/postmark_channel.py).
# Remplace SMTP, intransportable ici : port 587 en délai d'attente, égress limité au 443.
# Le jeton est PROPRE AU SERVEUR Postmark, jamais le jeton de compte.
FALKYE_POSTMARK_SERVER_TOKEN=
# Adresse expéditrice — doit appartenir au domaine d'envoi vérifié (avis.falkye.com),
# jamais la racine falkye.com ni falkye.ca.
FALKYE_POSTMARK_FROM_ADDR=
# Flux de messages. Défaut `broadcast` si vide — un résumé hebdomadaire est une DIFFUSION,
# jamais du transactionnel, et Postmark prend la distinction au sérieux. Ne remplir que si
# un flux au nom différent a été créé au compte.
FALKYE_POSTMARK_MESSAGE_STREAM=

# Canal courriel SMTP — écrit et testé, mais son transport n'existe pas dans cet
# environnement ni sur l'hôte (voir registry/notification_channels.yaml). Laissé vide.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_USE_TLS=true

# Canaux "à développer" (Phase 2) — voir registry/notification_channels.yaml pour le détail
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM_NUMBER=
# WHATSAPP_PROVIDER_TOKEN=
# WHATSAPP_PHONE_ID=

# User-Agent utilisé pour les requêtes vers les portails de données ouvertes et
# l'enrichissement web (identification transparente, bonne pratique / robots.txt)
FALKYE_USER_AGENT="Falkye/0.1 (repereur d'entreprises en croissance; contact: aquevillon@altalogistique.com)"

# Paiement intégré Stripe — plan Radar (spec section 9bis, falkye/billing/stripe_client.py).
# Non validé en direct dans cet environnement de développement (aucun compte Stripe réel
# disponible ici) — voir docs/STATUT_RESEAU.md.
FALKYE_STRIPE_SECRET_KEY=
FALKYE_STRIPE_PRICE_ID_RADAR=
FALKYE_STRIPE_WEBHOOK_SECRET=
FALKYE_STRIPE_SUCCESS_URL=
FALKYE_STRIPE_CANCEL_URL=

# Agrégateur de recrutement tiers — première source payante du plan Radar (spec
# section 9bis, falkye/sources/agregateur_recrutement.py). Choisir UN fournisseur
# (comparatif de prix en cours, voir docs/STATUT_RESEAU.md) :
FALKYE_AGREGATEUR_RECRUTEMENT_FOURNISSEUR=
#   FALKYE_AGREGATEUR_RECRUTEMENT_FOURNISSEUR=theirstack
FALKYE_THEIRSTACK_API_KEY=
#   FALKYE_AGREGATEUR_RECRUTEMENT_FOURNISSEUR=apify
FALKYE_APIFY_API_TOKEN=
FALKYE_APIFY_ACTOR_ID=

# Assistance à la configuration du profil par IA — Niveau 2 (spec Radar+, point 8,
# falkye/assistance_sphere_ia.py). Réservé aux plans Radar/Radar+ (gate binaire, pas
# de quota). Non validé en direct dans cet environnement de développement (aucune
# clé réelle disponible ici) — voir docs/STATUT_RESEAU.md.
ANTHROPIC_API_KEY=
# Modèle utilisé pour le Niveau 2 — défaut claude-haiku-4-5 (choix assumé pour une
# classification fermée à faible coût, voir docstring du module). Surclasser ici
# (ex. claude-sonnet-5) si l'usage réel montre que Haiku ne suffit pas.
FALKYE_ANTHROPIC_MODEL_NIVEAU2=

# --- Variables lues par le code, déclarées ici pour que la liste soit COMPLÈTE.
# outils/verifier_environnement.py compare ce fichier à ce que le code lit
# réellement : une variable lue mais non déclarée fait paraître ce document
# complet alors qu'il ne l'est pas. C'est ce qui a laissé partir un serveur sans
# FALKYE_LIEN_BASE_URL jusqu'au premier envoi réel.

# Jeton de la base distante (Turso). VIDE en local — le SQLite de développement
# n'en demande pas. INDISPENSABLE en production : sans lui la base est injoignable.
FALKYE_DB_AUTH_TOKEN=

# Cache de téléchargement des sources. Défaut `./cache`, un chemin RELATIF — donc
# sous le répertoire de travail, en LECTURE SEULE sous systemd (ProtectSystem).
# Les unités du cycle la posent elles-mêmes à /var/cache/falkye ; ne rien mettre
# ici, sauf hors systemd.
FALKYE_CACHE_DIR=

# Archives du moteur de diff. Défaut `./cache/diff_archive`, même remarque.
FALKYE_DIFF_ARCHIVE_DIR=

# Journal de repli — écrit UNIQUEMENT quand la base est muette (falkye/exploitation.py).
# Défaut /var/lib/falkye/journal-repli.jsonl, déjà le bon chemin sur l'hôte.
FALKYE_JOURNAL_REPLI=

# Révision déployée, écrite par la chaîne dans /opt/falkye/version.env, que les
# unités chargent SÉPARÉMENT des secrets. N'a rien à faire dans ce fichier-ci.
FALKYE_VERSION=

# Moteur de recherche de l'enrichissement web. Défaut `duckduckgo`, qui répond
# 403 Forbidden depuis l'hôte depuis le 2026-09-07 (voir docs/MIROIRS.md).
FALKYE_SEARCH_PROVIDER=

# Source Investissement Québec — URL du PDF si elle change chez le diffuseur.
FALKYE_IQ_PDF_URL=

# Empreinte attendue de l'archive REQ, posée par le flux d'import plutôt qu'ici.
FALKYE_REQ_SHA256=

# Mode opérateur de la ligne de commande — permet d'agir sur un profil sans
# session ouverte. À 1 UNIQUEMENT pour une intervention manuelle, jamais dans une
# unité : il contourne la dérivation du profil par la session.
FALKYE_OPERATOR=

# Fichier de session de la ligne de commande (`falkye auth login`).
FALKYE_SESSION_FILE=
