# Copier vers .env et remplir. Jamais commité (voir .gitignore).

# Base de données (par défaut : SQLite local, suffisant pour la Phase 1 / usage solo)
OBSERVADOR_DB_URL=sqlite:///./data/observador.sqlite3

# Canal de notification "email" (actif en Phase 1 — voir registry/notification_channels.yaml)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_USE_TLS=true

# Canaux "à développer" (Phase 2) — voir registry/notification_channels.yaml pour le détail
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM_NUMBER=
# WHATSAPP_PROVIDER_TOKEN=
# WHATSAPP_PHONE_ID=

# User-Agent utilisé pour les requêtes vers les portails de données ouvertes et
# l'enrichissement web (identification transparente, bonne pratique / robots.txt)
OBSERVADOR_USER_AGENT="Observador/0.1 (repereur d'entreprises en croissance; contact: aquevillon@altalogistique.com)"
