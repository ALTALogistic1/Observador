# Création du schéma manquant, jouée à chaque déploiement.
#
# Une unité plutôt qu'un appel direct depuis la chaîne de déploiement, pour une
# raison de portée : les identifiants de la base vivent dans un fichier que
# l'utilisateur de déploiement ne peut PAS lire. Cette unité tourne en root et
# le lit. Une chaîne compromise peut donc redémarrer le service, jamais lire la
# base.
[Unit]
Description=FALKYE — crée le schéma manquant
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=falkye
Group=falkye
WorkingDirectory=/opt/falkye/code
EnvironmentFile=/etc/falkye/falkye.env
EnvironmentFile=-/opt/falkye/version.env
# `init-db` est ADDITIF : il crée ce qui manque et ne détruit jamais. Le projet
# n'a pas d'outil de migration formel, et une table retirée du modèle reste en
# base plutôt que d'être supprimée — perdre de l'état est irréversible, garder
# une table morte ne l'est pas.
ExecStart=/opt/falkye/venv/bin/falkye init-db
# Ce que `init-db` NE FAIT PAS : ajouter une colonne à une table qui existe
# déjà. `create_all` crée les tables manquantes et ne regarde jamais à
# l'intérieur des tables présentes. Constaté le 2026-09-06 sur la base de
# production : les deux NOUVELLES tables du chantier 28 s'y étaient créées, mais
# `profiles.desabonne_le` manquait, et une simple lecture de profil levait
# `no such column`. Cette seconde ligne comble exactement ce trou — additive
# elle aussi, elle ajoute des colonnes et n'en change ni n'en retire aucune.
ExecStart=/opt/falkye/venv/bin/python outils/migration_colonnes.py --appliquer
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/falkye
