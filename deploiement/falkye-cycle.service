# Le cycle hebdomadaire — détection puis livraison.
#
# Une unité DÉCLENCHÉE PAR MINUTEUR plutôt qu'un processus qui dort en boucle :
# un processus dormant peut mourir en silence, et rien ne le relève. Une unité
# oneshot, elle, est relancée par le minuteur au prochain créneau quoi qu'il soit
# arrivé au précédent, et son échec est visible dans `systemctl list-units --failed`.
[Unit]
Description=FALKYE — cycle hebdomadaire de veille et de livraison
# La base est distante et le point d'entrée est public : sans réseau, le cycle
# écrirait son échec dans le fichier de repli pour rien.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=falkye
Group=falkye
WorkingDirectory=/opt/falkye/code
# Les secrets vivent sur l'hôte, jamais dans le dépôt — voir docs/DEPLOIEMENT.md.
EnvironmentFile=/etc/falkye/falkye.env
# La révision déployée, écrite par la chaîne de déploiement. Le `-` la rend
# facultative : un hôte préparé à la main démarre sans elle.
EnvironmentFile=-/opt/falkye/version.env
ExecStart=/opt/falkye/venv/bin/falkye cycle
# Un cycle qui dépasse largement sa durée normale est bloqué, pas lent : le tuer
# libère le créneau suivant au lieu d'empiler deux exécutions.
#
# **1 h 30, dimensionné sur une mesure du RÉGIME — 2026-09-08.** Un cycle
# hebdomadaire ordinaire, état de diff amorcé et filtre territorial actif, prend
# **29 min 10 s** : 13 min d'ingestion sur huit sources, puis 16 min
# d'enrichissement. Marge de 3,1.
#
# **Pourquoi 3,1 et pas plus, ni moins.** Les deux erreurs ne sont pas
# symétriques mais elles se valent : trop court TUE un cycle qui travaillait —
# vécu deux fois, à 3 600 s puis à 10 800 s ; trop long laisse un cycle BLOQUÉ
# mobiliser l'hôte une demi-journée sans que rien ne le signale. 5 400 s est le
# point où elles coûtent à peu près pareil. La marge absorbe une source lente,
# un portail en 504, un trimestre neuf qui ferait remonter le volume, ou un
# enrichissement qui redevient fonctionnel — donc plus lent qu'un échec
# immédiat.
#
# **L'histoire des valeurs, parce qu'elle explique la méthode.**
#   3 600 s  — une heure ronde, aucune mesure. A tué un cycle.
#   10 800 s — dimensionné sur l'AMORÇAGE. A tué le run de référence.
#   5 400 s  — dimensionné sur le RÉGIME, le seul état que ce minuteur verra.
# Régler sur l'amorçage aurait été l'erreur symétrique de l'heure ronde.
#
# **Où va le temps, et ce n'est plus ce qu'on croyait.** Le même code a TROIS
# régimes : limité par le processeur en développement, par la latence de la base
# à l'amorçage sur l'hôte, et EN RÉGIME par un enrichissement web qui échoue en
# 403 — seize minutes sur vingt-neuf passées à échouer, pour 6 % de processeur.
# Voir docs/MIROIRS.md, « Ce que le miroir coûte à chaque cycle » : avant de
# conclure sur la lenteur d'un cycle, établir lequel des trois on observe.
TimeoutStartSec=5400

# Le cache de téléchargement des sources. SANS ces deux lignes, le connecteur
# CKAN écrit dans le chemin RELATIF `./cache`, qui se résout sous
# WorkingDirectory — en lecture seule sous ProtectSystem=strict. Mesuré en
# production le 2026-09-07 : la première source est morte sur
# `OSError: [Errno 30] Read-only file system: 'cache'`, et toutes les sources
# CKAN auraient fait pareil. `CacheDirectory=` fait créer /var/cache/falkye par
# systemd, avec le bon propriétaire, et l'ajoute lui-même aux chemins
# accessibles en écriture.
CacheDirectory=falkye
Environment=FALKYE_CACHE_DIR=/var/cache/falkye

# Durcissement — le cycle n'a besoin ni d'écrire ailleurs que dans son état, ni
# de privilèges.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/falkye

[Install]
WantedBy=multi-user.target
