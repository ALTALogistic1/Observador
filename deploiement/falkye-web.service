# Le point d'entrée HTTPS — désabonnement (RFC 8058) et rétroaction.
#
# Sert en clair sur la boucle locale ; le mandataire inverse porte le certificat.
[Unit]
Description=FALKYE — point d'entrée public (lien.falkye.com)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=falkye
Group=falkye
WorkingDirectory=/opt/falkye/code
EnvironmentFile=/etc/falkye/falkye.env
# La révision déployée, écrite par la chaîne de déploiement. Le `-` la rend
# facultative : un hôte préparé à la main démarre sans elle.
EnvironmentFile=-/opt/falkye/version.env
# `--no-control-socket` : gunicorn 25.1 ouvre une socket de commande pour son
# outil `gunicornc` (voir l'état des ouvriers, en ajouter, recharger, arrêter).
# Elle se crée dans $XDG_RUNTIME_DIR ou, à défaut, dans $HOME/.gunicorn — donc
# ici /opt/falkye/.gunicorn, que `ProtectSystem=strict` rend en lecture seule.
# Le service démarrait quand même, mais laissait une ligne ERROR à chaque
# redémarrage :
#
#     [ERROR] Control server error: [Errno 30] Read-only file system:
#             '/opt/falkye/.gunicorn'
#
# Corrigé en RETIRANT la fonction plutôt qu'en ouvrant un chemin en écriture.
# Deux raisons : on ne se sert pas de `gunicornc`, et cette socket est une
# interface de commande — ajuster les ouvriers, arrêter le service — sur le SEUL
# chemin par lequel un désabonnement peut passer. La surface qu'on n'ouvre pas
# est celle qu'on n'a pas à surveiller.
#
# Et un journal qui porte une erreur permanente cesse d'être lisible : il a été
# construit pour distinguer trois silences, pas pour qu'on apprenne à ignorer
# une ligne rouge.
ExecStart=/opt/falkye/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 2 \
    --no-control-socket \
    --access-logfile - \
    'falkye.web.app:create_app()'
ExecReload=/bin/kill -s HUP $MAINPID
# Toujours relancer : ce service est le SEUL chemin par lequel un désabonnement
# peut passer. Le laisser mort transformerait une panne en plainte pour pourriel.
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/falkye

[Install]
WantedBy=multi-user.target
